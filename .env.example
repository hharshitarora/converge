# Copy to .env and fill in. .env is gitignored; never put real keys in this file.

# Core three apps
SLACK_BOT_TOKEN=xoxb-...
NOTION_TOKEN=ntn_...
NOTION_PARENT_PAGE_ID=...
LINEAR_API_KEY=lin_api_...
LINEAR_TEAM_KEY=ENG

# Free fourth: uses the already-authenticated gh CLI, so only the owner is needed
GITHUB_OWNER=

# Compile step (natural language -> desired-state spec).
# Without it, a deterministic template planner is used instead.
ANTHROPIC_API_KEY=sk-ant-...

# Providers run against local twins unless this is 1. Each app independently
# falls back to its twin if its own credential is missing.
CONVERGE_LIVE=0
